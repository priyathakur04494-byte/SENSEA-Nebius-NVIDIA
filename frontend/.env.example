# SENSEA Frontend Environment Variables
# --------------------------------------

# Point this to your backend API URL.
# 1. Local Web testing:
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# 2. Local Mobile testing (Expo Go on phone - use machine's LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000

# 3. Deployed Backend (Render / Railway / Nebius / Fly.io / Cloud VM):
# EXPO_PUBLIC_API_URL=https://sensea-api.onrender.com
