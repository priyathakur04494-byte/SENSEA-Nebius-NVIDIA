# ============================================================
# SENSEA Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ── NVIDIA / Nemotron ─────────────────────────────────────────
# Get your key from https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key-here

# ── API Access Security ───────────────────────────────────────
# Set a strong random string to protect all endpoints.
# Leave empty in local development (no auth required).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SENSEA_API_KEY=

# ── Deployment Environment ────────────────────────────────────
# "development" enables hot-reload when running main.py directly.
# "production" disables reload and tightens security warnings.
SENSEA_ENV=development

# ── ML Backend Directory ──────────────────────────────────────
# Absolute path to the "ML Backend" folder that contains ai_engine.py etc.
# Default: auto-detected relative to this file.
# ML_BACKEND_DIR=C:/path/to/sensea/ML Backend

# ── Whisper.cpp ───────────────────────────────────────────────
# Root of the compiled whisper.cpp repo.
# Windows: C:/Users/<you>/whisper.cpp
# Linux/macOS: /home/<you>/whisper.cpp
WHISPER_CPP_PATH=C:/Users/YOUR_USERNAME/whisper.cpp

# ── Whisper model names (without ggml- prefix and .bin suffix) ──
WHISPER_SMALL_MODEL=small
WHISPER_MEDIUM_MODEL=medium

# ── Sign Language Model ───────────────────────────────────────
# Full path to the .pth checkpoint file.
# SIGN_LANGUAGE_MODEL_PATH=C:/path/to/sensea/ML Backend/sign_language/models/sign_language_model.pth

# ── MediaPipe Task Files ──────────────────────────────────────
# Directory containing hand_landmarker.task and pose_landmarker_lite.task
# MEDIAPIPE_DIR=C:/path/to/sensea/ML Backend/sign_language/models/mediapipe

# ── Server ────────────────────────────────────────────────────
SENSEA_HOST=0.0.0.0
SENSEA_PORT=8000

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Use "*" for local development only.
# Production: set exact Expo/frontend URL, e.g.:
#   CORS_ORIGINS=https://your-app.expo.dev,http://192.168.1.42:8081
CORS_ORIGINS=*

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO
